---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import LeadsList from '../../components/dashboard/LeadsList';
import { Users } from 'lucide-react';
---

<script>
  import { supabase } from '../../lib/supabase';

  // --- Auth logic ---
  const { data: { session } } = await supabase.auth.getSession();
  if (!session) {
    window.location.href = '/auth/login';
  } else {
    // Only teachers should see this page
    const { data: profile } = await supabase
      .from('profiles')
      .select('role')
      .eq('id', session.user.id)
      .single();

    if (profile?.role === 'student') {
      window.location.href = '/dashboard';
    } else {
      document.getElementById('teacher-view')?.classList.remove('hidden');
    }
  }
</script>

<DashboardLayout title="Leads Capturados — Destrave Hub" activeNav="leads">
  <div id="teacher-view" class="hidden">
    <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
      <header class="mb-8">
        <h1 class="font-outfit text-3xl font-black text-slate-dark tracking-tight">Leads Capturados 🎯</h1>
        <p class="text-slate-mid mt-1 font-medium leading-relaxed">Gerencie contatos capturados através das atividades experimentais (Links Públicos).</p>
      </header>

      <LeadsList client:load />
    </div>
  </div>
</DashboardLayout>
