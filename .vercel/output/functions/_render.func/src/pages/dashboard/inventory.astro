---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { InventoryManager } from '../../components/inventory/InventoryManager';
import { Backpack } from 'lucide-react';
---

<DashboardLayout title="Meu Inventário | Mercado Destrave">
  <div class="inventory-page container mx-auto px-4 py-8">
    <div class="flex items-center gap-4 mb-8">
      <div class="w-14 h-14 bg-brand/10 rounded-2xl flex items-center justify-center text-brand">
        <Backpack size={32} />
      </div>
      <div>
        <h1 class="text-3xl font-black text-slate-800 font-outfit">Seu Acervo</h1>
        <p class="text-slate-500 font-bold">Gerencie seus itens equipados e personalize sua experiência.</p>
      </div>
    </div>

    <InventoryManager client:load />
  </div>

  <style>
    .inventory-page {
      max-width: 1000px;
      margin: 0 auto;
    }
  </style>
</DashboardLayout>
