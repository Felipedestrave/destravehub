---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { StudentHistory } from '../../components/student/StudentHistory';
import { supabase } from '../../lib/supabase';

// Redireciona se não for aluno
---

<DashboardLayout title="Meu Histórico — Destrave Hub" activeNav="history">
  <div class="max-w-5xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <header class="mb-8">
        <h1 class="font-outfit text-3xl font-black text-slate-dark tracking-tight">Meu Histórico 📜</h1>
        <p class="text-slate-mid mt-1 font-medium leading-relaxed">Acompanhe seu progresso e os feedbacks do Sensei.</p>
    </header>
    
    <StudentHistory client:load />
  </div>
</DashboardLayout>
