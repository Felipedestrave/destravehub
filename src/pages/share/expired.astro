---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Acesso Expirado — Destrave Hub">
    <div class="expired-page">
        <div class="expired-card">
            <div class="expired-icon">⏰</div>
            <h1 class="font-outfit">Sua janela de 48h encerrou</h1>
            <p>
                O link de acesso experimental tem validade de <strong>48 horas</strong> a partir 
                do seu cadastro para manter o desafio real e motivador.
            </p>
            <p class="expired-cta-text">
                Quer fazer mais missões e acompanhar sua evolução sem limite de tempo?
            </p>
            <a 
                href="https://wa.me/?text=Oi!%20Quero%20saber%20mais%20sobre%20o%20Destrave%20Hub!" 
                target="_blank" 
                rel="noopener noreferrer"
                class="btn-whatsapp"
            >
                💬 Falar com o Sensei no WhatsApp
            </a>
        </div>
    </div>
</Layout>

<style>
    .expired-page {
        min-height: 100vh;
        background-color: var(--color-ice);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }

    .expired-card {
        background: var(--color-white);
        border: 1px solid var(--color-slate-border);
        border-radius: 1.5rem;
        padding: 3rem 2.5rem;
        max-width: 420px;
        width: 100%;
        text-align: center;
        box-shadow: var(--shadow-card);
    }

    .expired-icon {
        font-size: 3.5rem;
        margin-bottom: 1.25rem;
    }

    h1 {
        font-size: 1.75rem;
        font-weight: 800;
        color: var(--color-slate-dark);
        margin-bottom: 1rem;
        line-height: 1.2;
    }

    p {
        color: var(--color-slate-mid);
        line-height: 1.65;
        margin-bottom: 0.75rem;
    }

    .expired-cta-text {
        color: var(--color-slate-dark);
        font-weight: 600;
        margin-top: 1.5rem;
        margin-bottom: 1.25rem;
    }

    .btn-whatsapp {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.9rem 1.75rem;
        background-color: #25D366;
        color: #fff;
        font-family: var(--font-outfit);
        font-weight: 700;
        font-size: 1rem;
        border-radius: 0.875rem;
        text-decoration: none;
        transition: transform 150ms ease, background-color 150ms ease;
    }

    .btn-whatsapp:hover {
        background-color: #1ebe5d;
        transform: translateY(-2px);
    }
</style>
