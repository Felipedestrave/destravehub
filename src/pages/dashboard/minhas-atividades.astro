---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { ActivitiesTimeline } from '../../components/student/ActivitiesTimeline';
---

<DashboardLayout title="Minhas Atividades | Destrave Hub">
  <main class="timeline-container">
    <ActivitiesTimeline client:load />
  </main>
</DashboardLayout>

<style>
  .timeline-container {
    padding: 2rem;
    height: 100vh;
    overflow-y: auto;
    background-color: var(--color-slate-bg);
  }
</style>
