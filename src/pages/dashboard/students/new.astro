---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import AddStudentForm from '../../../components/dashboard/AddStudentForm.tsx';
---

<DashboardLayout title="Novo Aluno — Destrave Hub" activeNav="students">
  <div class="registration-header">
    <div class="breadcrumb">
      <a href="/dashboard">Dashboard</a>
      <span class="chevron">›</span>
      <span class="current">Novo Aluno</span>
    </div>
    <h1 class="page-title">Cadastrar Novo Aluno</h1>
    <p class="page-subtitle">Configure a conta oficial do seu aluno para começar as missões.</p>
  </div>

  <AddStudentForm client:load />

  <style>
    .registration-header {
      max-width: 800px;
      margin: 0 auto 2.5rem;
    }
    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.8125rem;
      color: var(--color-slate-mid);
      margin-bottom: 0.75rem;
    }
    .breadcrumb a {
      color: var(--color-brand);
      text-decoration: none;
      font-weight: 600;
      transition: opacity 0.2s;
    }
    .breadcrumb a:hover {
      opacity: 0.7;
    }
    .breadcrumb .chevron {
      opacity: 0.5;
    }
    .breadcrumb .current {
      font-weight: 500;
    }
    .page-title {
      font-family: var(--font-outfit);
      font-size: 2.25rem;
      font-weight: 800;
      color: var(--color-slate-dark);
      margin: 0 0 0.5rem;
      letter-spacing: -0.02em;
    }
    .page-subtitle {
      font-size: 1.125rem;
      color: var(--color-slate-mid);
      margin: 0;
    }

    @media (max-width: 640px) {
      .page-title {
        font-size: 1.75rem;
      }
      .page-subtitle {
        font-size: 1rem;
      }
    }
  </style>
</DashboardLayout>
