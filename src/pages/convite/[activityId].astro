---
import Layout from '@/layouts/Layout.astro';
import { supabaseAdmin } from '@/lib/supabase-admin';

const { activityId } = Astro.params;

if (!activityId) {
    return Astro.redirect('/404');
}

// Fetch the activity info to personalize the page
const { data: activity, error } = await supabaseAdmin
    .from('activities')
    .select('id, title, type, teacher_id')
    .eq('id', activityId)
    .single();

if (error || !activity) {
    return Astro.redirect('/404?error=invalid_invite');
}

// Map activity type to friendly display name and icon
const typeMap: Record<string, { label: string; icon: string; desc: string }> = {
    escuta: {
        label: 'Destrave a Escuta',
        icon: '🎧',
        desc: 'Exercício de compreensão auditiva'
    },
    mrp:    {
        label: 'Destrave Conversação',
        icon: '🎭',
        desc: 'Role Play em idioma estrangeiro'
    },
    flashcards: {
        label: 'Destrave Cards',
        icon: '🃏',
        desc: 'Revisão de vocabulário e gramática'
    },
};
const typeInfo = typeMap[activity.type] ?? { label: 'Missão Especial', icon: '🚀', desc: 'Atividade interativa' };
---

<Layout
    title={`Você foi convidado! — ${activity.title}`}
    description={`O Sensei Felipe preparou uma missão especial de ${typeInfo.label} para você. Acesse agora e complete em até 48 horas!`}
>
    <div class="invite-page">

        <!-- Background organic shapes -->
        <div class="bg-shape bg-shape--1" aria-hidden="true"></div>
        <div class="bg-shape bg-shape--2" aria-hidden="true"></div>

        <!-- Header -->
        <header class="invite-header">
            <div class="logo-mark">
                <span class="logo-icon">⚡</span>
                <span class="logo-text font-outfit">Destrave Hub</span>
            </div>
        </header>

        <!-- Main content -->
        <main class="invite-main">

            <!-- Left: Sensei Avatar + Speech Bubble -->
            <div class="invite-sensei" id="sensei-col">
                <div class="speech-bubble">
                    <p>Ei! Preparei uma missão especial só pra você. Aceita o desafio? 🎯</p>
                </div>
                <img
                    src="/assets/host/sensei-3d.webp"
                    alt="Sensei Felipe"
                    class="sensei-avatar"
                    loading="eager"
                    width="420"
                    height="420"
                />
            </div>

            <!-- Right: Mission Card + Form -->
            <div class="invite-form-col" id="form-col">

                <!-- Mission badge -->
                <div class="mission-badge">
                    <span class="badge-icon">{typeInfo.icon}</span>
                    <span class="badge-label">{typeInfo.desc}</span>
                </div>

                <!-- Mission title -->
                <h1 class="mission-title font-outfit">{activity.title}</h1>

                <!-- 48h urgency banner -->
                <div class="urgency-banner" role="status">
                    <span class="urgency-pulse" aria-hidden="true"></span>
                    <span>⏰ Acesso válido por <strong>48 horas</strong> após o cadastro</span>
                </div>

                <!-- Capture form -->
                <form id="capture-form" class="capture-form" novalidate>
                    <input type="hidden" name="activityId" value={activityId} />

                    <div class="field-group">
                        <label for="lead-name" class="field-label">Seu nome</label>
                        <input
                            id="lead-name"
                            name="name"
                            type="text"
                            placeholder="Como posso te chamar?"
                            class="field-input"
                            autocomplete="given-name"
                            required
                        />
                    </div>

                    <div class="field-group">
                        <label for="lead-whatsapp" class="field-label">WhatsApp <span class="field-required">*</span></label>
                        <input
                            id="lead-whatsapp"
                            name="whatsapp"
                            type="tel"
                            placeholder="(11) 9 0000-0000"
                            class="field-input"
                            autocomplete="tel"
                            required
                        />
                    </div>

                    <div class="field-group">
                        <label for="lead-email" class="field-label">E-mail <span class="field-optional">(opcional)</span></label>
                        <input
                            id="lead-email"
                            name="email"
                            type="email"
                            placeholder="seu@email.com"
                            class="field-input"
                            autocomplete="email"
                        />
                    </div>

                    <div id="form-error" class="form-error" role="alert" aria-live="polite"></div>

                    <button id="submit-btn" type="submit" class="btn-submit font-outfit">
                        <span id="btn-text">🚀 Começar Minha Missão</span>
                        <span id="btn-loader" class="btn-loader" hidden aria-label="Carregando..."></span>
                    </button>

                    <p class="form-disclaimer">
                        Seu WhatsApp é usado apenas para você receber contato do Sensei sobre seus resultados. Sem spam.
                    </p>
                </form>
            </div>
        </main>
    </div>
</Layout>

<script>
    const form = document.getElementById('capture-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const btnText = document.getElementById('btn-text') as HTMLSpanElement;
    const btnLoader = document.getElementById('btn-loader') as HTMLSpanElement;
    const formError = document.getElementById('form-error') as HTMLDivElement;

    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        formError.textContent = '';

        const formData = new FormData(form);
        const name = (formData.get('name') as string)?.trim();
        const whatsapp = (formData.get('whatsapp') as string)?.trim();
        const email = (formData.get('email') as string)?.trim();
        const activityId = formData.get('activityId') as string;

        // Client-side validation
        if (!name) {
            formError.textContent = 'Por favor, informe o seu nome.';
            document.getElementById('lead-name')?.focus();
            return;
        }
        if (!whatsapp) {
            formError.textContent = 'O WhatsApp é obrigatório para receber seu acesso.';
            document.getElementById('lead-whatsapp')?.focus();
            return;
        }

        // Show loading state
        submitBtn.disabled = true;
        btnText.hidden = true;
        btnLoader.hidden = false;

        try {
            const response = await fetch('/api/leads/capture', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, email, whatsapp, activityId }),
            });

            const result = await response.json();

            if (!response.ok || !result.success) {
                formError.textContent = result.error || 'Ops! Algo deu errado. Tente novamente.';
                submitBtn.disabled = false;
                btnText.hidden = false;
                btnLoader.hidden = true;
                return;
            }

            // Redirect to the mission player
            window.location.href = result.redirectUrl;

        } catch {
            formError.textContent = 'Erro de conexão. Verifique sua internet e tente novamente.';
            submitBtn.disabled = false;
            btnText.hidden = false;
            btnLoader.hidden = true;
        }
    });
</script>

<style>
    /* ─── Page Shell ─── */
    .invite-page {
        min-height: 100vh;
        background-color: var(--color-ice);
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
    }

    /* ─── Organic BG Shapes (subtle, no mesh gradient) ─── */
    .bg-shape {
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
        z-index: 0;
    }
    .bg-shape--1 {
        width: 480px;
        height: 480px;
        background: rgba(88, 49, 126, 0.06);
        top: -120px;
        right: -80px;
    }
    .bg-shape--2 {
        width: 320px;
        height: 320px;
        background: rgba(255, 127, 50, 0.05);
        bottom: -100px;
        left: -60px;
    }

    /* ─── Header ─── */
    .invite-header {
        position: relative;
        z-index: 10;
        padding: 1.5rem 2rem;
    }
    .logo-mark {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }
    .logo-icon {
        font-size: 1.5rem;
    }
    .logo-text {
        font-size: 1.125rem;
        font-weight: 800;
        color: var(--color-brand);
        letter-spacing: -0.02em;
    }

    /* ─── Main Layout (asymmetric: avatar 45% / form 55%) ─── */
    .invite-main {
        flex: 1;
        position: relative;
        z-index: 10;
        display: grid;
        grid-template-columns: 45fr 55fr;
        align-items: center;
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem 2rem 4rem;
        gap: 3rem;
        width: 100%;
    }

    /* ─── Sensei Column ─── */
    .invite-sensei {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        animation: slideFromLeft 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }
    .sensei-avatar {
        width: 100%;
        max-width: 400px;
        object-fit: contain;
        filter: drop-shadow(0 24px 40px rgba(88, 49, 126, 0.18));
        animation: float 4s ease-in-out infinite;
        mix-blend-mode: darken; /* Tira o fundo branco nativo da imagem */
    }

    /* ─── Speech Bubble ─── */
    .speech-bubble {
        background: var(--color-white);
        border: 2px solid var(--color-brand);
        border-radius: 1.25rem 1.25rem 1.25rem 0.25rem;
        padding: 1rem 1.25rem;
        max-width: 280px;
        margin-bottom: 1rem;
        position: relative;
        box-shadow: var(--shadow-card);
    }
    .speech-bubble p {
        font-family: var(--font-outfit);
        font-size: 0.9375rem;
        font-weight: 600;
        color: var(--color-slate-dark);
        line-height: 1.5;
        margin: 0;
    }

    /* ─── Form Column ─── */
    .invite-form-col {
        animation: slideFromRight 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 0.1s both;
    }

    /* ─── Mission Badge ─── */
    .mission-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--color-lilac);
        color: var(--color-brand);
        padding: 0.375rem 1rem;
        border-radius: 9999px;
        font-family: var(--font-outfit);
        font-weight: 700;
        font-size: 0.8125rem;
        letter-spacing: 0.02em;
        margin-bottom: 1rem;
    }
    .badge-icon { font-size: 1rem; }

    /* ─── Mission Title ─── */
    .mission-title {
        font-size: clamp(1.5rem, 3.5vw, 2.25rem);
        font-weight: 800;
        color: var(--color-slate-dark);
        line-height: 1.15;
        letter-spacing: -0.03em;
        margin-bottom: 1.25rem;
    }

    /* ─── Urgency Banner ─── */
    .urgency-banner {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        background: rgba(255, 127, 50, 0.1);
        border: 1.5px solid rgba(255, 127, 50, 0.4);
        border-radius: 0.75rem;
        padding: 0.625rem 1rem;
        font-size: 0.9rem;
        color: var(--color-slate-dark);
        margin-bottom: 1.75rem;
    }
    .urgency-pulse {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--color-action);
        flex-shrink: 0;
        animation: pulse 1.8s ease-in-out infinite;
    }

    /* ─── Form ─── */
    .capture-form {
        display: flex;
        flex-direction: column;
        gap: 1.125rem;
    }
    .field-group {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
    }
    .field-label {
        font-family: var(--font-outfit);
        font-size: 0.875rem;
        font-weight: 700;
        color: var(--color-slate-dark);
    }
    .field-required { color: var(--color-action); }
    .field-optional {
        font-weight: 400;
        color: var(--color-slate-mid);
        font-size: 0.8rem;
    }
    .field-input {
        padding: 0.8125rem 1rem;
        border: 2px solid var(--color-slate-border);
        border-radius: 0.875rem;
        font-family: var(--font-inter);
        font-size: 1rem;
        color: var(--color-slate-dark);
        background: var(--color-white);
        transition: border-color 150ms ease, box-shadow 150ms ease;
        outline: none;
    }
    .field-input::placeholder { color: var(--color-slate-mid); }
    .field-input:focus {
        border-color: var(--color-brand);
        box-shadow: 0 0 0 3px rgba(88, 49, 126, 0.12);
    }

    /* ─── Error ─── */
    .form-error {
        color: #e53e3e;
        font-size: 0.875rem;
        font-weight: 600;
        min-height: 1.25rem;
    }

    /* ─── Submit Button ─── */
    .btn-submit {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 1rem 2rem;
        background-color: var(--color-action);
        color: var(--color-white);
        font-size: 1.0625rem;
        font-weight: 800;
        border: none;
        border-radius: 0.875rem;
        cursor: pointer;
        box-shadow: var(--shadow-btn);
        transition: background-color 200ms ease, transform 200ms ease, box-shadow 200ms ease;
        margin-top: 0.25rem;
    }
    .btn-submit:hover:not(:disabled) {
        background-color: var(--color-action-hover);
        transform: translateY(-3px);
        box-shadow: 0 12px 28px -4px rgba(255, 127, 50, 0.45);
    }
    .btn-submit:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }
    .btn-loader {
        width: 20px;
        height: 20px;
        border: 3px solid rgba(255,255,255,0.35);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
    }

    /* ─── Disclaimer ─── */
    .form-disclaimer {
        font-size: 0.78rem;
        color: var(--color-slate-mid);
        text-align: center;
        line-height: 1.5;
    }

    /* ─── Animations ─── */
    @keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }
    @keyframes pulse {
        0%, 100% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.4); opacity: 0.6; }
    }
    @keyframes slideFromLeft {
        from { opacity: 0; transform: translateX(-40px); }
        to   { opacity: 1; transform: translateX(0); }
    }
    @keyframes slideFromRight {
        from { opacity: 0; transform: translateX(40px); }
        to   { opacity: 1; transform: translateX(0); }
    }
    @keyframes spin {
        to { transform: rotate(360deg); }
    }

    /* Respect user's motion preferences */
    @media (prefers-reduced-motion: reduce) {
        .sensei-avatar { animation: none; }
        .invite-sensei, .invite-form-col { animation: none; }
        .urgency-pulse { animation: none; }
    }

    /* ─── Responsive: Mobile ─── */
    @media (max-width: 768px) {
        .invite-main {
            grid-template-columns: 1fr;
            padding: 1.5rem 1.25rem 3rem;
            gap: 1.5rem;
        }
        .invite-sensei {
            flex-direction: row;
            align-items: flex-end;
            gap: 1rem;
        }
        .sensei-avatar {
            max-width: 140px;
            order: 2;
        }
        .speech-bubble {
            order: 1;
            border-radius: 1rem 1rem 1rem 0.25rem;
            margin-bottom: 0;
            max-width: 220px;
            font-size: 0.875rem;
        }
        .mission-title {
            font-size: 1.5rem;
        }
    }
</style>
