---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Destrave Hub — Ferramentas de Autoria para Professores de Idiomas",
  description = "Transforme PDFs e materiais estáticos em missões interativas para seus alunos. O combo de ferramentas para professores de idiomas que ganham tempo e organizam tudo em um só lugar."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#58317E" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />

    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />

    <script>
      import { supabase } from '../lib/supabase';

      const initTheme = async () => {
        try {
          const { data: { session } } = await supabase.auth.getSession();
          if (!session) return;

          const { data: profile } = await supabase
            .from('profiles')
            .select('equipped')
            .eq('id', session.user.id)
            .maybeSingle();

          const equipped = profile?.equipped || {};
          const currentThemeId = (equipped as any).theme;

          const applyTheme = (themeId: string | null) => {
            const targets = [document.documentElement, document.body];
            targets.forEach(el => {
              const classesToRemove = Array.from(el.classList).filter(cls => cls.startsWith('theme-'));
              classesToRemove.forEach(cls => el.classList.remove(cls));
            });

            if (themeId && themeId !== 'null') {
              document.documentElement.classList.add(themeId);
              document.documentElement.setAttribute('data-theme', themeId);
              document.body.classList.add(themeId);
            } else {
              document.documentElement.removeAttribute('data-theme');
            }
          };

          if (currentThemeId) {
            applyTheme(currentThemeId);
          }

          window.addEventListener('theme-changed', (e: any) => {
            applyTheme(e.detail);
          });
        } catch (err) {
          console.error('[Layout Theme] Error:', err);
        }
      };

      initTheme();
    </script>
  </body>
</html>
