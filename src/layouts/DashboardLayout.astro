---
import '../styles/global.css';

interface Props {
  title?: string;
  activeNav?: 'students' | 'activities' | 'draw' | 'calendar' | 'escuta' | 'mrp' | 'flashcards' | 'settings';
}

const {
  title = 'Dashboard — Destrave Hub',
  activeNav = 'students',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="dashboard-body">

    <!-- ===== MOBILE HEADER ===== -->
    <div class="mobile-nav-bar md:hidden">
      <div class="sidebar-logo">
        <div class="sidebar-logo-icon">DH</div>
        <span class="sidebar-logo-text">Destrave Hub</span>
      </div>
      <button id="mobile-menu-toggle" class="mobile-toggle-btn">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
    </div>

    <!-- ===== SIDEBAR ===== -->
    <aside class="sidebar" id="dashboard-sidebar">
      <div class="sidebar-backdrop md:hidden" id="sidebar-backdrop"></div>
      
      <div class="sidebar-content">
        <!-- Logo -->
        <div class="sidebar-logo hidden md:flex">
          <div class="sidebar-logo-icon">DH</div>
          <span class="sidebar-logo-text">Destrave Hub</span>
        </div>

        <!-- Nav -->
        <nav class="sidebar-nav hidden" id="teacher-nav">
          <a href="/dashboard" class={`sidebar-link ${activeNav === 'students' ? 'active' : ''}`}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            Alunos
          </a>
          <a href="/dashboard/calendar" class={`sidebar-link ${activeNav === 'calendar' ? 'active' : ''}`}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Agenda
          </a>
          <a href="/draw" class={`sidebar-link ${activeNav === 'draw' ? 'active' : ''}`}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r="2.5"/><path d="M4 20l1.39-4.17a6.2 6.2 0 0 1 5.91-4.14h4.14"/><rect x="2" y="10" width="8" height="8" rx="2"/><path d="M16 11l4 0"/><path d="M18 9l0 4"/></svg>
            Destrave Draw
          </a>
          <a href="/dashboard/missions/escuta" class={`sidebar-link ${activeNav === 'escuta' ? 'active' : ''}`}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>
            Destrave a Escuta
          </a>
          <a href="/dashboard/missions/mrp" class={`sidebar-link ${activeNav === 'mrp' ? 'active' : ''}`}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 10s3-3 3-8"/><path d="M22 10s-3-3-3-8"/><path d="M10 2c0 4.4-3.6 8-8 8"/><path d="M14 2c0 4.4 3.6 8 8 8"/><path d="M2 10s2 2 2 5"/><path d="M22 10s-2 2-2 5"/><path d="M8 15a4 4 0 0 0 8 0"/><path d="M10 22v-3"/><path d="M14 22v-3"/></svg>
            Destrave MRP
          </a>
          <a href="/dashboard/missions/flashcards" class={`sidebar-link ${activeNav === 'flashcards' ? 'active' : ''}`}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/><rect x="5" y="5" width="14" height="14" rx="2"/><path d="M9 11V9a3 3 0 0 1 6 0v2"/></svg>
            Destrave Cards
          </a>
          <a href="/dashboard/activities" class={`sidebar-link ${activeNav === 'activities' ? 'active' : ''}`}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            Atividades
          </a>
        </nav>

        <nav class="sidebar-nav hidden" id="student-nav">
          <a href="/dashboard" class={`sidebar-link ${activeNav === 'students' ? 'active' : ''}`}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
            Mergulho no Japonês
          </a>
        </nav>

        <!-- Logout -->
        <div class="sidebar-footer">
          <button id="logout-btn" class="sidebar-logout">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Sair
          </button>
        </div>
      </div>
    </aside>

    <!-- ===== MAIN AREA ===== -->
    <div class="dashboard-main">
      <!-- Top Bar -->
      <header class="dashboard-topbar">
        <div>
          <p class="topbar-greeting">Olá, <span id="user-name" class="topbar-name">Professor</span> 👋</p>
        </div>
        <div class="topbar-badge hidden sm:flex">
          <span class="badge-brand" id="role-badge">Professor</span>
        </div>
      </header>

      <!-- Page Content -->
      <main class="dashboard-content">
        <div class="responsive-container">
          <slot />
        </div>
      </main>
    </div>

  </body>
</html>

<script>
  import { supabase } from '../lib/supabase';

  // --- 1. Logout Listener (Highest Priority) ---
  const initLogout = () => {
    const logoutBtn = document.getElementById('logout-btn');
    if (logoutBtn) {
      logoutBtn.addEventListener('click', async () => {
        try {
          console.log('[Auth] Deslogando...');
          const { error } = await supabase.auth.signOut();
          if (error) throw error;
          
          // Limpa qualquer dado residual no localStorage por garantia
          localStorage.removeItem('sb-access-token');
          localStorage.removeItem('sb-refresh-token');
          
          window.location.href = '/auth/login';
        } catch (err) {
          console.error('[Auth] Erro ao deslogar:', err);
          // Força o redirecionamento mesmo se o signOut do Supabase falhar
          window.location.href = '/auth/login';
        }
      });
    }
  };

  initLogout();

  // --- 2. Auth & Session Logic ---
  const initDashboard = async () => {
    try {
      const { data: { session } } = await supabase.auth.getSession();

      if (!session) {
        window.location.href = '/auth/login';
        return;
      }

      // Fetch profile with more resilience
      let { data: profiles, error: profileError } = await supabase
        .from('profiles')
        .select('*')
        .eq('id', session.user.id);
      
      const profile = profiles && profiles.length > 0 ? profiles[0] : null;

      if (profileError) {
        console.warn('Erro ao carregar perfil:', profileError);
      }

      const nameEl = document.getElementById('user-name');
      const roleBadge = document.getElementById('role-badge');
      const teacherNav = document.getElementById('teacher-nav');
      const studentNav = document.getElementById('student-nav');

      // Determine role from metadata first (faster), then profile
      const userRole = profile?.role || session.user.user_metadata?.role || 'teacher';
      console.log('[Dashboard] Identified role:', userRole);

      if (nameEl) {
        const defaultName = userRole === 'teacher' ? 'Professor' : 'Aluno';
        const firstName = profile?.full_name?.split(' ')[0] ?? session.user.email?.split('@')[0] ?? defaultName;
        nameEl.textContent = firstName;
      }

      if (roleBadge) {
        roleBadge.textContent = userRole === 'teacher' ? 'Professor' : 'Aluno';
        roleBadge.className = userRole === 'teacher' ? 'badge-brand' : 'badge-student';
        // Force visibility of badge to verify role
        roleBadge.parentElement?.classList.remove('hidden');
      }

      // Toggle navs based on role
      if (userRole === 'student') {
        if (teacherNav) teacherNav.style.display = 'none';
        if (studentNav) studentNav.style.display = 'flex';
        if (roleBadge) {
          roleBadge.textContent = 'Aluno';
          roleBadge.className = 'badge-student';
        }
      } else {
        if (teacherNav) teacherNav.style.display = 'flex';
        if (studentNav) studentNav.style.display = 'none';
        if (roleBadge) {
          roleBadge.textContent = 'Professor';
          roleBadge.className = 'badge-brand';
        }
      }
    } catch (err) {
      console.error('[Dashboard] Erro crítico no init:', err);
    }
  };

  // Run dashboard init
  initDashboard();

  // --- 3. Mobile Sidebar Toggle ---
  const sidebar = document.getElementById('dashboard-sidebar');
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const backdrop = document.getElementById('sidebar-backdrop');

  const toggleSidebar = () => {
    sidebar?.classList.toggle('open');
  };

  toggleBtn?.addEventListener('click', toggleSidebar);
  backdrop?.addEventListener('click', toggleSidebar);
</script>

<style>
  .dashboard-body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background-color: var(--color-ice);
    font-family: var(--font-inter);
    margin: 0;
  }

  @media (min-width: 768px) {
    .dashboard-body {
      flex-direction: row;
    }
  }

  /* ---- Mobile Header ---- */
  .mobile-nav-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background-color: var(--color-slate-dark);
    z-index: 100;
  }

  @media (min-width: 768px) {
    .mobile-nav-bar {
      display: none; /* Explicitly hide on desktop */
    }
  }

  .mobile-toggle-btn {
    background: none;
    border: none;
    color: white;
    cursor: pointer;
    padding: 0.5rem;
  }

  /* ---- Sidebar ---- */
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 280px;
    z-index: 1000;
    transform: translateX(-100%);
    transition: transform 0.3s ease;
  }

  .sidebar.open {
    transform: translateX(0);
  }

  .sidebar-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(0,0,0,0.5);
    backdrop-filter: blur(4px);
  }

  .sidebar-content {
    position: relative;
    width: 100%;
    height: 100%;
    background-color: var(--color-slate-dark);
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1rem;
    box-shadow: 20px 0 50px rgba(0,0,0,0.2);
  }

  @media (min-width: 768px) {
    .sidebar {
      position: sticky;
      transform: translateX(0);
      width: 240px;
      flex-shrink: 0;
      box-shadow: none;
      display: block;
    }
    .sidebar-content {
      box-shadow: none;
    }
    .sidebar-backdrop {
      display: none;
    }
  }

  .sidebar-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.5rem 1.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    margin-bottom: 1.5rem;
  }

  .sidebar-logo-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background-color: var(--color-action);
    color: white;
    font-family: var(--font-outfit);
    font-weight: 800;
    font-size: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    letter-spacing: 0.05em;
  }

  .sidebar-logo-text {
    font-family: var(--font-outfit);
    font-weight: 700;
    font-size: 0.95rem;
    color: white;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0.875rem;
    border-radius: 0.75rem;
    color: rgba(255,255,255,0.55);
    font-family: var(--font-outfit);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .sidebar-link:hover {
    background-color: rgba(255,255,255,0.06);
    color: rgba(255,255,255,0.9);
  }

  .sidebar-link.active {
    background-color: var(--color-action);
    color: white;
  }

  .sidebar-footer {
    padding-top: 1rem;
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  .sidebar-logout {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.75rem 0.875rem;
    border-radius: 0.75rem;
    background: none;
    border: none;
    color: rgba(255,255,255,0.4);
    font-family: var(--font-outfit);
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease;
    text-align: left;
  }

  .sidebar-logout:hover {
    background-color: rgba(255,255,255,0.06);
    color: rgba(255, 100, 80, 0.9);
  }

  /* ---- Main Area ---- */
  .dashboard-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
    width: 100%;
  }

  .dashboard-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem;
    background-color: var(--color-white);
    border-bottom: 1px solid var(--color-slate-border);
  }

  @media (min-width: 768px) {
    .dashboard-topbar {
      padding: 1.25rem 2rem;
    }
  }

  .topbar-greeting {
    font-family: var(--font-inter);
    font-size: 0.875rem;
    color: var(--color-slate-mid);
    margin: 0;
  }

  @media (min-width: 640px) {
    .topbar-greeting {
      font-size: 0.95rem;
    }
  }

  .topbar-name {
    font-weight: 700;
    color: var(--color-slate-dark);
  }

  .dashboard-content {
    flex: 1;
    padding: 1rem;
    overflow-y: auto;
  }

  @media (min-width: 768px) {
    .dashboard-content {
      padding: 2rem;
    }
  }

  .responsive-container {
    max-width: 100%;
    margin: 0 auto;
    width: 100%;
  }
</style>
